{
  "name": "hltb-for-steam-unofficial",
  "version": "2.2.5",
  "private": true,
  "description": "An unofficial Chrome and Firefox extension that shows HowLongToBeat estimates on Steam game pages.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:acceptance": "node scripts/build-local-acceptance.mjs",
    "serve:acceptance": "node scripts/serve-snapshot-candidate.mjs",
    "smoke:acceptance": "node scripts/smoke-local-snapshot.mjs",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "xpi:firefox:unsigned": "wxt zip -b firefox && node scripts/create-firefox-unsigned-xpi.mjs",
    "zip:build": "npm run zip && npm run xpi:firefox:unsigned && npm run verify:sources",
    "zip:all": "npm run verify:release-data && npm run zip:build",
    "postinstall": "wxt prepare",
    "prepare:wxt": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:live": "node scripts/live-smoke.mjs",
    "snapshot:import": "node scripts/import-hltb-snapshot.mjs",
    "snapshot:update-packaged": "node scripts/update-packaged-snapshot.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.mjs",
    "verify:release-data": "node scripts/verify-release-snapshot.mjs",
    "verify:remote-candidate": "node scripts/verify-remote-candidate.mjs",
    "screenshot": "node scripts/capture-widget-screenshot.mjs",
    "screenshot:store": "node scripts/render-store-gallery.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:firefox": "node scripts/verify-firefox-build.mjs",
    "verify:sources": "node scripts/verify-source-archive.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify:build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "stream-json": "^3.7.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
